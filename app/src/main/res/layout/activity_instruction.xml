<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:padding="24dp">

    <TextView
        android:id="@+id/instructionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Safety Instructions"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#191B2A"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/instructionSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Follow these steps when you need emergency help"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/instructionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/instructionScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/instructionSubtitle"
        app:layout_constraintBottom_toTopOf="@id/gotItbutton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Add emergency contacts"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#191B2A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Open Menu → Change Emergency Number and save the people you want to receive your SOS message."
                android:textSize="15sp"
                android:textColor="#5F6368" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="2. Start Safety Service"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#191B2A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap START SAFETY SERVICE before using shake detection."
                android:textSize="15sp"
                android:textColor="#5F6368" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="3. Shake the phone"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#191B2A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Shake the phone 3 times. The safety service will detect the shake and send an SOS message to your saved emergency contacts."
                android:textSize="15sp"
                android:textColor="#5F6368" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="4. Keep permissions enabled"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#191B2A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Location and SMS permissions are required for the SOS feature to work."
                android:textSize="15sp"
                android:textColor="#5F6368" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/gotItbutton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="GOT IT"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D62828"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>